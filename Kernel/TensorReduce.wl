(* ::Package:: *)

(* TensorReduce backend for xPerm's signed-permutation canonicalization API.
   This file is loaded in xPermLibraryLink's Private context. It deliberately
   uses only permutation conversion from xPerm, never either xPerm canonicalizer.

   A slot-to-label permutation p is encoded by the scalar contraction
       A_(i1 ... in) B_(i_p^-1(1) ... i_p^-1(n)).
   A has exactly the supplied signed slot group S. B has exactly the signed
   label group D generated by DummySet/RepeatedSet. Relabeling A's slots and
   B's slots therefore traverses precisely the same signed double coset as
   xPerm. TensorReduce canonicalizes this two-array contraction; its remaining
   cross-contraction pairs recover a representative of that double coset.
   Conflicting signs give zero. The scalar coefficient carries the sign.

   Both arrays use one symbolic dimension: it imposes no numerical dimension
   identities and does not add any symmetry. Different index spaces remain
   distinct through their separate D generators. In particular, metric-free
   dummy pairs have pair exchanges but no endpoint flip; an antisymmetric
   metric supplies negative endpoint flips. Repeated labels are positive
   permutations inside their own sets. Free and unlisted labels are fixed by D.

   The representative is TensorReduce's own choice. It need not equal the
   base-dependent representative selected by Butler-Portugal/Niehoff.
   No second canonicalization or silent fallback changes that choice.
*)

TensorReduceCanonicalPerm::input =
    "Invalid signed permutation, symmetry group, or disjoint free/dummy/repeated labels for TensorReduce canonicalization (degree `1`).";
TensorReduceCanonicalPerm::reduce =
    "TensorReduce did not return a signed two-array contraction with a valid permutation of the `1` labels. No other canonicalization backend was used.";

(* Convert valid xPerm notation without constructing a strong generating set.
   PermQ alone also accepts general numeric multiples and sums; the exact
   signed Images match below intentionally limits the domain to phase +/-1. *)
TensorReduceSignedImages[permutation_, degree_Integer] :=
    Module[{converted, result},
        If[!TrueQ[xAct`xPerm`PermQ[permutation]] ||
            !TrueQ[xAct`xPerm`PermDeg[permutation] <= degree], Return[$Failed]];
        converted = Quiet[Check[
            xAct`xPerm`TranslatePerm[permutation, {xAct`xPerm`Images, degree}],
            $Failed]];
        result = Replace[converted, {
            xAct`xPerm`Images[images_List] :> {images, 1},
            Times[-1, xAct`xPerm`Images[images_List]] :> {images, -1},
            _ :> $Failed
        }];
        If[result === $Failed || Sort[result[[1]]] =!= Range[degree],
            $Failed, result]
    ];

(* Adjacent transpositions generate each whole symmetric group. For dummy
   pairs the analogous adjacent pair exchange preserves endpoint orientation.
   These sparse descriptions avoid an unnecessary Schreier-Sims computation. *)
TensorReduceSwapGenerator[degree_Integer, pairs_List, sign_Integer] :=
    {ReplacePart[Range[degree], Flatten[
        ({#[[1]] -> #[[2]], #[[2]] -> #[[1]]} &) /@ pairs]], sign};

TensorReduceSlotGenerators[group_, degree_Integer] :=
    Module[{generators, slots, sign},
        Which[
            MatchQ[group, xAct`xPerm`StrongGenSet[_List, _xAct`xPerm`GenSet]],
                If[!VectorQ[group[[1]], IntegerQ] ||
                    Length[DeleteDuplicates[group[[1]]]] =!= Length[group[[1]]] ||
                    !SubsetQ[Range[degree + 2], group[[1]]], Return[$Failed]];
                generators = List @@ group[[2]],
            Head[group] === xAct`xPerm`GenSet,
                generators = List @@ group,
            MatchQ[group, (System`Symmetric | System`Antisymmetric)[_List]],
                slots = First[group];
                If[!VectorQ[slots, IntegerQ] ||
                    Length[DeleteDuplicates[slots]] =!= Length[slots] ||
                    !SubsetQ[Range[degree], slots], Return[$Failed]];
                sign = If[Head[group] === System`Antisymmetric, -1, 1];
                Return[TensorReduceSwapGenerator[degree, {#}, sign] & /@
                    Partition[slots, 2, 1]],
            True, Return[$Failed]
        ];
        generators = TensorReduceSignedImages[#, degree] & /@ generators;
        If[MemberQ[generators, $Failed], $Failed, generators]
    ];

TensorReduceCanonicalPerm[permutation_, degree_Integer, group_, frees_List, sets_List] :=
    Block[{$Assumptions = True, tensorReduceArrayA, tensorReduceArrayB,
        tensorReduceDimension},
        Module[{signedPermutation, slotGenerators, labelGenerators = {}, labels = frees,
            set, pairs, slots, metric, assumptions, expression, reduced, term,
            phase = 1, factors, contractions, normalized, result},
            If[degree < 0,
                Message[TensorReduceCanonicalPerm::input, degree]; Return[$Failed]];
            signedPermutation = TensorReduceSignedImages[permutation, degree];
            slotGenerators = TensorReduceSlotGenerators[group, degree];
            If[signedPermutation === $Failed || slotGenerators === $Failed,
                Message[TensorReduceCanonicalPerm::input, degree]; Return[$Failed]];

            (* Validate before the generator-building loop. In Wolfram Language,
               Return inside Do would only exit that loop, permitting a malformed
               set to fall through into reduction. Unlisted labels are allowed;
               like explicit free labels they have no D generator and stay fixed. *)
            If[!AllTrue[sets, MatchQ[#,
                    xAct`xPerm`DummySet[_, {{_Integer, _Integer} ...}, -1 | 0 | 1] |
                    xAct`xPerm`RepeatedSet[{___Integer}]] &],
                Message[TensorReduceCanonicalPerm::input, degree]; Return[$Failed]];
            labels = Join[frees, Flatten[
                (If[Head[#] === xAct`xPerm`DummySet, #[[2]], First[#]] &) /@ sets]];
            If[!VectorQ[labels, IntegerQ] ||
                Length[DeleteDuplicates[labels]] =!= Length[labels] ||
                !SubsetQ[Range[degree], labels],
                Message[TensorReduceCanonicalPerm::input, degree]; Return[$Failed]];

            Do[
                Which[
                    Head[set] === xAct`xPerm`DummySet,
                        pairs = set[[2]]; metric = set[[3]];
                        If[metric =!= 0,
                            labelGenerators = Join[labelGenerators,
                                TensorReduceSwapGenerator[degree, {#}, metric] & /@ pairs]];
                        labelGenerators = Join[labelGenerators,
                            TensorReduceSwapGenerator[degree, Transpose[#], 1] & /@
                                Partition[pairs, 2, 1]],
                    Head[set] === xAct`xPerm`RepeatedSet,
                        slots = First[set];
                        labelGenerators = Join[labelGenerators,
                            TensorReduceSwapGenerator[degree, {#}, 1] & /@
                                Partition[slots, 2, 1]]
                ],
                {set, sets}
            ];

            (* A supplied negative identity forces zero at every rank. Handle
               that relation directly: TensorReduce in Wolfram 15.1 otherwise
               misses it for a rank-one symbolic array. This is not a call to
               another canonicalizer. Rank-zero inputs then need no contraction. *)
            If[MemberQ[slotGenerators, {Range[degree], -1}], Return[0]];
            If[degree === 0,
                Return[signedPermutation[[2]] xAct`xPerm`Images[{}]]];

            (* Fixed, scoped private symbols preserve TensorReduce's lexical
               array order across calls. Explicit assumptions plus Block prevent
               an unrelated user's $Assumptions from entering this formal model. *)
            assumptions = Quiet[{
                Element[tensorReduceArrayA, System`Arrays[
                    ConstantArray[tensorReduceDimension, degree], Reals, slotGenerators]],
                Element[tensorReduceArrayB, System`Arrays[
                    ConstantArray[tensorReduceDimension, degree], Reals, labelGenerators]]
            }, Arrays::symm0];
            expression = System`TensorContract[
                System`TensorProduct[tensorReduceArrayA, tensorReduceArrayB],
                MapIndexed[{First[#2], degree + #1} &, signedPermutation[[1]]]];
            reduced = Quiet[Check[
                System`TensorReduce[expression, Assumptions -> assumptions], $Failed]];
            If[reduced === 0, Return[0]];

            term = reduced;
            If[MatchQ[term, Times[-1, _System`TensorContract]],
                phase = -1; term = -term];
            If[!MatchQ[term, System`TensorContract[_System`TensorProduct, _List]],
                Message[TensorReduceCanonicalPerm::reduce, degree]; Return[$Failed]];
            factors = List @@ First[term];
            contractions = Last[term];
            If[!MemberQ[{{tensorReduceArrayA, tensorReduceArrayB},
                    {tensorReduceArrayB, tensorReduceArrayA}}, factors] ||
                !MatchQ[contractions, {{_Integer, _Integer} ...}] ||
                Length[contractions] =!= degree ||
                Sort[Flatten[contractions]] =!= Range[2 degree],
                Message[TensorReduceCanonicalPerm::reduce, degree]; Return[$Failed]];
            normalized = Sort /@ contractions;
            If[!AllTrue[normalized, #[[1]] <= degree < #[[2]] &],
                Message[TensorReduceCanonicalPerm::reduce, degree]; Return[$Failed]];
            (* Pair order inside TensorContract is immaterial. If TensorReduce
               reverses the array factors, transpose the bipartite matching. *)
            If[First[factors] === tensorReduceArrayB,
                normalized = ({#[[2]] - degree, #[[1]] + degree} &) /@ normalized];
            result = Last /@ Sort[normalized] - degree;
            If[Sort[result] =!= Range[degree],
                Message[TensorReduceCanonicalPerm::reduce, degree]; Return[$Failed]];
            signedPermutation[[2]] phase xAct`xPerm`Images[result]
        ]
    ];

TensorReduceCanonicalPerm[___] :=
    (Message[TensorReduceCanonicalPerm::input, "unknown"]; $Failed);

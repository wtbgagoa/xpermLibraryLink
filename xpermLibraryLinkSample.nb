                 3.5 (CurrentValue["FontCapHeight"]/AbsoluteCurrentValue[
                  Magnification])}]], 
             GraphicsBox[{
               Thickness[0.041666666666666664`], {
                FaceForm[
                 LightDarkSwitched[

  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"$OperatingSystem", "===", "\"\<Windows\>\""}], ",", 
    RowBox[{"FindLibrary", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], 
      "<>", "\"\<build-win\\\\libxpermLL.dll\>\""}], "]"}], ",", 
    RowBox[{"FindLibrary", "[", 

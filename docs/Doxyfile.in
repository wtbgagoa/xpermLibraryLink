# Configured by CMake. Paths are quoted for source/build directories with spaces.
PROJECT_NAME           = "xPermLibraryLink"
PROJECT_NUMBER         = "0.2.0"
PROJECT_BRIEF          = "Tensor canonicalization: algorithms, implementation, and interfaces"
OUTPUT_DIRECTORY       = "@XPERM_DOC_OUTPUT@"
OUTPUT_LANGUAGE        = English
DOXYFILE_ENCODING      = UTF-8
INPUT_ENCODING         = UTF-8
INPUT                  = "@PROJECT_SOURCE_DIR@/docs" \
                         "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/src"
FILE_PATTERNS          = *.md *.h *.hpp *.cpp
RECURSIVE              = NO
USE_MDFILE_AS_MAINPAGE  = "@PROJECT_SOURCE_DIR@/docs/index.md"
EXAMPLE_PATH           = "@PROJECT_SOURCE_DIR@/docs/examples"
EXAMPLE_PATTERNS       = *.cpp
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@/"
STRIP_FROM_INC_PATH    = "@PROJECT_SOURCE_DIR@/include/"
FULL_PATH_NAMES        = YES

# Keep implementation classes visible: the paper-to-code guide links to them.
# EXTRACT_ALL also keeps inherited low-level utilities browsable. It is not a
# claim that every historical utility has a full parameter-by-parameter manual.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
INTERNAL_DOCS          = YES
JAVADOC_AUTOBRIEF      = NO
MULTILINE_CPP_IS_BRIEF = NO
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
VERBATIM_HEADERS       = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
# Static tabs keep the member-index links consistent even for short lists
# without letter headings (Doxygen 1.18 dynamic menus emit broken quick links).
HTML_DYNAMIC_MENUS     = NO
DISABLE_INDEX          = NO
GENERATE_LATEX         = @XPERM_DOC_GENERATE_LATEX@
LATEX_OUTPUT           = latex
USE_PDFLATEX           = YES
PDF_HYPERLINKS         = YES
LATEX_EXTRA_STYLESHEET = "@PROJECT_SOURCE_DIR@/docs/latex-unicode.sty"
GENERATE_XML           = YES
XML_OUTPUT             = xml
# HTML uses plain-text mathematics and needs neither TeX nor a CDN.
USE_MATHJAX            = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = "DLLEXPORT=" "EXTERN_C="
INCLUDE_PATH           = "@PROJECT_SOURCE_DIR@/include"

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = @XPERM_DOC_WARN_AS_ERROR@
WARN_LOGFILE           = "@XPERM_DOC_OUTPUT@/warnings.log"

HAVE_DOT               = @XPERM_DOC_HAVE_DOT@
DOT_PATH               = "@XPERM_DOC_DOT_PATH@"
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
